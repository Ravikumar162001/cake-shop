# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Gmail account used to send order/OTP emails (use a Gmail App Password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/cakeShop?retryWrites=true&w=majority

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Email address that should have admin privileges
ADMIN_EMAIL=admin@example.com

# Port (optional, defaults to 3000)
PORT=3000
